# [TEMPLATE] dev 환경 Secret — 실제 값으로 채워 secrets.yaml로 복사 후 master에서 직접 apply
#
# 작업 순서 (Step 4 §8 참조):
#   1) 이 파일을 secrets.yaml로 복사: cp secrets.yaml.example secrets.yaml
#   2) <...> placeholder를 실제 값으로 치환 (16자 이상 random 권장)
#   3) secrets.yaml은 .gitignore 처리 — git에 절대 commit 금지
#   4) master로 scp 후 sudo kubectl apply -f secrets.yaml
#   5) apply 끝나면 /tmp의 복사본 삭제
#
# regcred (registry pull secret)는 별도 명령으로 생성 — 아래 §regcred 참조
---
apiVersion: v1
kind: Secret
metadata:
  name: mysql-secret
  namespace: butterfly
type: Opaque
stringData:
  # MySQL root 계정 비밀번호 (16자 이상 권장)
  root-password: "<MYSQL_ROOT_PASSWORD>"
  # butterfly 앱 계정 비밀번호 (Spring SPRING_DATASOURCE_PASSWORD로 주입)
  app-password: "<MYSQL_APP_PASSWORD>"
---
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: butterfly
type: Opaque
stringData:
  # JWT 서명 시크릿 (32자 이상 random base64 권장)
  jwt-secret: "<JWT_SECRET>"
# ============================================================
# regcred (GHCR pull secret) — 별도 명령으로 생성
#
# kubectl create secret docker-registry regcred \
#   --docker-server=ghcr.io \
#   --docker-username=<GHCR_USERNAME> \
#   --docker-password=<GHCR_TOKEN> \
#   --docker-email=2026b101@gmail.com \
#   --namespace=butterfly \
#   --dry-run=client -o yaml > regcred.yaml
#
# 위 출력파일도 .gitignore 대상 — 마찬가지로 master에 scp 후 apply.
# ============================================================
