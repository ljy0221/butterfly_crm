# Butterfly Observability — 환경 변수 템플릿
# 운영 시: cp .env.example .env && vim .env (모든 PLACEHOLDER 채우기)
# .env 는 .gitignore — 절대 커밋 금지.

# =============================================================================
# Grafana
# =============================================================================
GF_ADMIN_USER=admin
# 강한 비밀번호 (16자+) — 부팅 후 UI에서 즉시 변경 권장
GF_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
