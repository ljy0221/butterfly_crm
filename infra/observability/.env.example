# Butterfly Observability — 환경 변수 템플릿
# 운영 시: cp .env.example .env && vim .env (모든 PLACEHOLDER 채우기)
# .env 는 .gitignore — 절대 커밋 금지.

# =============================================================================
# Caddy / TLS
# =============================================================================
DOMAIN=k14b101.p.ssafy.io
LE_EMAIL=woduddl1000@gmail.com

# Basic Auth — `docker run --rm caddy:2.8-alpine caddy hash-password --plaintext '평문'`
# 으로 생성한 bcrypt 해시 (예: `$2a$14$xxxxx....`).
#
# ⚠️ 중요: docker-compose는 .env 의 `$` 를 변수 보간 문자로 해석.
# bcrypt 해시 안의 모든 `$` 를 `$$` 로 두 번 써야 Caddy 가 원본 해시를 받음.
# 예) caddy hash-password 결과: $2a$14$AbCdEf...
#     → .env 에 적을 때:        $$2a$$14$$AbCdEf...
#
# admin: 운영자(/grafana, /lgtm/alerts 접근)
# promtail-client: 자동화 agent(/lgtm/loki, /lgtm/prom 접근)
BASIC_AUTH_ADMIN_HASH=$$2a$$14$$REPLACE_WITH_BCRYPT_HASH_ESCAPED
BASIC_AUTH_PROMTAIL_HASH=$$2a$$14$$REPLACE_WITH_BCRYPT_HASH_ESCAPED

# =============================================================================
# Grafana
# =============================================================================
GF_ADMIN_USER=admin
# 강한 비밀번호 (16자+) — 부팅 후 UI에서 즉시 변경 권장
GF_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# =============================================================================
# Alertmanager
# =============================================================================
# Slack incoming webhook URL — 미설정 시 알람 발송 안 됨 (Phase 1 기본 동작)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/HERE
