# Caddy — LGTM 단일 진입점 (TLS + Basic Auth + 경로 분기)
#
# ADR-0018: node-exporter + Promtail (K8s 측) → /lgtm/* 로 push.
# 운영자 Grafana UI → /grafana/*.
#
# 환경 변수 (docker-compose.yml에서 주입):
#   DOMAIN                    e.g. k14b101.p.ssafy.io
#   LE_EMAIL                  Let's Encrypt 등록 이메일
#   BASIC_AUTH_ADMIN_HASH     `caddy hash-password` 결과 (운영자용, /grafana 접근)
#   BASIC_AUTH_PROMTAIL_HASH  `caddy hash-password` 결과 (Promtail/agent push 전용)

{
	email {$LE_EMAIL}
	# ACME 운영 모드. 발급 실패 디버깅 시 staging 활성화:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$DOMAIN} {
	encode gzip zstd

	# 보안 헤더 (전 location 공통)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# Caddy가 자동 추가하는 Server 헤더 제거
		-Server
	}

	# =========================================================================
	# /grafana/* — 운영자 UI (admin Basic Auth)
	# Grafana 자체 로그인이 1차, Caddy Basic Auth가 0차 게이트
	# =========================================================================
	handle_path /grafana/* {
		basicauth {
			admin {$BASIC_AUTH_ADMIN_HASH}
		}
		reverse_proxy grafana:3000
	}

	# Grafana는 sub-path 운영이라 /grafana 접근도 처리해야 함 (trailing slash)
	@grafana_root path /grafana
	redir @grafana_root /grafana/ 301

	# =========================================================================
	# /lgtm/loki/* — Promtail push 수신 (promtail-client Basic Auth)
	# 본 경로는 자동화된 agent 전용. 운영자 직접 호출 X.
	# =========================================================================
	handle_path /lgtm/loki/* {
		basicauth {
			promtail-client {$BASIC_AUTH_PROMTAIL_HASH}
		}
		# Loki HTTP API 진입 (push: /loki/api/v1/push)
		reverse_proxy loki:3100
	}

	# =========================================================================
	# /lgtm/prom/* — Prometheus remote_write 수신
	# =========================================================================
	handle_path /lgtm/prom/* {
		basicauth {
			promtail-client {$BASIC_AUTH_PROMTAIL_HASH}
		}
		reverse_proxy prometheus:9090
	}

	# =========================================================================
	# /lgtm/alerts/* — Alertmanager UI (admin Basic Auth)
	# =========================================================================
	handle_path /lgtm/alerts/* {
		basicauth {
			admin {$BASIC_AUTH_ADMIN_HASH}
		}
		reverse_proxy alertmanager:9093
	}

	# =========================================================================
	# 기본 fallback — 알 수 없는 경로 차단 (404)
	# 단 ACME 챌린지(/.well-known/acme-challenge/*)는 Caddy 내부 핸들러가 처리
	# =========================================================================
	respond "Not Found" 404
}
