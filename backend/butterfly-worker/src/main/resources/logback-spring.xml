<?xml version="1.0" encoding="UTF-8"?>
<!--
  butterfly-worker 로그 구성.

  Worker는 HTTP 컨테이너가 없으므로 RequestIdFilter는 적용되지 않는다.
  대신 메시지 컨슈머(Kafka/RabbitMQ)에서 메시지 헤더의 requestId를
  MDC에 직접 넣어 사용한다 (구현은 컨슈머 측 책임).
-->
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="butterfly-worker"/>

    <property name="CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} [req=%X{requestId:-} proj=%X{projectId:-} mem=%X{memberId:-}] - %msg%n"/>

    <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${appName}"}</customFields>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>projectId</includeMdcKeyName>
            <includeMdcKeyName>memberId</includeMdcKeyName>
            <includeMdcKeyName>traceId</includeMdcKeyName>
        </encoder>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="JSON_STDOUT"/>
        </root>
    </springProfile>

    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.b101.butterfly" level="DEBUG"/>
    </springProfile>

</configuration>
