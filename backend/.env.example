# ============================================================
# Butterfly Backend — 환경 변수 템플릿
# ============================================================
#
# 사용법:
#   cp backend/.env.example backend/.env
#   # 각 값을 본인 로컬 환경에 맞게 채움
#
# 주의:
#   - 실제 비밀번호/토큰을 본 파일에 적지 않는다 (commit 됨).
#   - backend/.env 는 .gitignore 에 포함되어 commit 되지 않는다.
#   - 운영(dev/stage/prod) 시크릿은 시크릿 매니저에서 주입한다.
#     상세: backend/docs/operations/secrets-and-environments.md
# ============================================================

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3307
DB_NAME=butterfly
# 로컬 권장: root / root  (docker-compose 기본값)
# dev 이상: app_user 권장 (DB 권한 분리 정책, S14P31B101-182)
DB_USERNAME=root
DB_PASSWORD=__CHANGE_ME__

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- JWT ----
# 최소 32자 무작위 문자열. `openssl rand -base64 32` 로 생성 권장.
# 운영 환경에서는 시크릿 매니저에서 주입.
JWT_SECRET=__GENERATE_ME_AT_LEAST_32_CHARS__

# ---- Mail (SMTP) ----
# 로컬: MailHog (host=localhost, port=1025, username/password 비움)
# dev 이상: Gmail SMTP 또는 운영 메일 서버
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@butterfly.local
MAIL_BASE_URL=http://localhost:5175

# ---- CORS ----
# 콤마 구분. 운영은 도메인 명시 권장 (와일드카드 금지).
BUTTERFLY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8080

# ---- Rate Limit ----
BUTTERFLY_RATELIMIT_ENABLED=true
BUTTERFLY_RATELIMIT_RPM=60
BUTTERFLY_RATELIMIT_BURST=100

# ============================================================
# 미사용 / 제거 예정 (참고)
# ============================================================
# AES_KEY        — S14P31B101-206 으로 AesEncryptionService 제거 후 application.yml 잔재만 남아있음.
#                  본 PR(S14P31B101-62)에서 application.yml 도 정리.
# RABBITMQ_*     — 2026-05-11 RabbitMQ 제거 결정. Kafka 단일화 (관련 작업 S14P31B101-222).
# ============================================================
