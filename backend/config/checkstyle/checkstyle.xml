<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
Butterfly Checkstyle Configuration - Minimal Rules
프로젝트 초반에는 핵심 위생 룰만 적용. 점진적으로 강화.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- =====================================================
         File-level checks
         ===================================================== -->

    <!-- 줄 끝 공백 금지 -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Trailing whitespace not allowed"/>
        <property name="severity" value="warning"/>
    </module>

    <!-- 파일 길이 제한 (2000줄) -->
    <module name="FileLength">
        <property name="max" value="2000"/>
    </module>

    <!-- =====================================================
         TreeWalker - Java syntax-level checks
         ===================================================== -->
    <module name="TreeWalker">

        <!-- 사용 안 하는 import 금지 -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>

        <!-- 중복 import 금지 -->
        <module name="RedundantImport"/>

        <!-- import * 금지 -->
        <module name="AvoidStarImport"/>

        <!-- 빈 catch 블록 금지 (예외를 무시하면 안 됨) -->
        <module name="EmptyBlock">
            <property name="tokens" value="LITERAL_CATCH"/>
            <property name="option" value="text"/>
        </module>

        <!-- System.out.println 금지 (logger 사용 강제) -->
        <module name="Regexp">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Use logger instead of System.out/err"/>
            <property name="severity" value="warning"/>
        </module>

        <!-- printStackTrace 금지 (logger 사용 강제) -->
        <module name="Regexp">
            <property name="format" value="\.printStackTrace\(\)"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Use logger.error(msg, ex) instead of e.printStackTrace()"/>
            <property name="severity" value="warning"/>
        </module>

        <!-- 메서드 길이 제한 (150줄) -->
        <module name="MethodLength">
            <property name="max" value="150"/>
            <property name="countEmpty" value="false"/>
        </module>

        <!-- 매개변수 개수 제한 (10개) -->
        <module name="ParameterNumber">
            <property name="max" value="10"/>
        </module>

        <!-- 불필요한 modifier 금지 (interface의 public 등) -->
        <module name="RedundantModifier"/>

        <!-- 빈 statement(;) 금지 -->
        <module name="EmptyStatement"/>

        <!-- equals만 override했는데 hashCode 안 한 경우 -->
        <module name="EqualsHashCode"/>

        <!-- == 로 String 비교 금지 -->
        <module name="StringLiteralEquality"/>

    </module>
</module>
