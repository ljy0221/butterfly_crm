# S14P31B101-294 — 부하 테스트 환경변수 예시.
# 실제 사용: 본 파일을 test-data.env 로 복사 후 실제 값 채우기.
# test-data.env 는 .gitignore (개인 환경별 다름).
#
# 사전 준비 (Spring app 부팅 후 직접 curl 또는 swagger UI):
# 1) POST /api/v1/auth/login → JWT accessToken
# 2) POST /api/v1/projects → projectId
# 3) POST /api/v1/projects/{pid}/segments → segmentId
# 4) POST /api/v1/projects/{pid}/message-templates → templateId
# 5) POST /api/v1/projects/{pid}/campaigns × 130개 (B 용 100 + E 용 30) → campaignIds (DRAFT)

BASE_URL=http://host.docker.internal:8080
JWT=eyJhbGciOiJIUzI1NiJ9...실제JWT값...
PROJECT_ID=1

# 시나리오 B (Throughput burst) 용 — DRAFT 상태 100개 권장
CAMPAIGN_IDS=101,102,103,104,105,106,107,108,109,110,...

# 시나리오 E (Latency single) 용 — B 와 겹치지 않게 별도 30개
LATENCY_CAMPAIGN_IDS=201,202,203,204,205,...
